{
  "name": "so-i-started-blasting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --development",
    "serve:dev": "SERVE_DIR=build-dev node tools/serve.mjs",
    "benchmark:render": "node tools/performance/benchmark.mjs",
    "test": "node tools/check-syntax.mjs && node --test tests/*.test.mjs",
    "test:browser": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "check:public": "node tools/check-public.mjs",
    "infrastructure:verify": "node tools/check-infrastructure.mjs",
    "test:certificates": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm test && npm run test:certificates && npm run assets:verify && npm run build && npm run test:browser && npm run test:webkit",
    "serve": "node tools/serve.mjs",
    "assets:verify": "node tools/asset-baseline.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "es-module-lexer": "3.0.2",
    "postprocessing": "6.39.5",
    "stats-gl": "4.2.3"
  }
}
